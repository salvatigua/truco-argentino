{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*", "../../packages/shared/src/cards.ts", "../../packages/shared/src/game.ts", "../../packages/shared/src/score.ts", "../../packages/shared/src/types.ts"]
}